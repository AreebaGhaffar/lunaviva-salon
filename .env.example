# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
ADMIN_PASSWORD="choose-a-strong-password-without-dollar-sign"
SESSION_SECRET="random-48-character-value"
CRON_SECRET="random-48-character-value"
APP_URL="http://localhost:3000"
ADMIN_WHATSAPP="+15555550100"
ADMIN_EMAIL="owner@example.com"

# AI receptionist. For delivery: gpt-4o, and leave the last two empty.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""
OPENAI_REASONING_EFFORT=""

# Payments: empty = simulated, "stripe" = real Stripe.
PAYMENTS_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email: empty = Outbox only, "resend" = real email.
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Only "true" on a demo site.
ALLOW_MOCK_PAYMENTS=""